rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSiteDocument(data) {
      return data.keys().hasOnly([
        "url",
        "domain",
        "clientWhatsapp",
        "password",
        "createdAt",
        "updatedAt",
        "deletedAt"
      ]) &&
      data.url is string &&
      data.url.size() > 0 &&
      data.domain is string &&
      data.domain.size() > 0 &&
      data.clientWhatsapp is string &&
      data.clientWhatsapp.size() > 0 &&
      data.password is string &&
      data.password.size() > 0 &&
      data.createdAt is string &&
      data.updatedAt is string &&
      (data.deletedAt == null || data.deletedAt is string);
    }

    function isAuthorDocument(data) {
      return data.keys().hasOnly([
        "name",
        "bio",
        "siteId",
        "avatarUrl",
        "createdAt",
        "updatedAt",
        "deletedAt"
      ]) &&
      data.name is string &&
      data.name.size() > 0 &&
      data.bio is string &&
      data.bio.size() > 0 &&
      data.siteId is string &&
      data.siteId.size() > 0 &&
      data.avatarUrl is string &&
      data.createdAt is string &&
      data.updatedAt is string &&
      (data.deletedAt == null || data.deletedAt is string);
    }

    function isPostDocument(data) {
      return data.keys().hasOnly([
        "siteId",
        "title",
        "htmlContent",
        "backgroundUrl",
        "authorId",
        "createdAt",
        "updatedAt",
        "deletedAt"
      ]) &&
      data.siteId is string &&
      data.siteId.size() > 0 &&
      data.title is string &&
      data.title.size() > 0 &&
      data.htmlContent is string &&
      data.htmlContent.size() > 0 &&
      data.backgroundUrl is string &&
      data.authorId is string &&
      data.authorId.size() > 0 &&
      data.createdAt is string &&
      data.updatedAt is string &&
      (data.deletedAt == null || data.deletedAt is string);
    }

    match /authors/{authorId} {
      allow get, list: if true;
      allow create: if isAuthorDocument(request.resource.data) &&
        request.resource.data.deletedAt == null;
      allow update: if isAuthorDocument(request.resource.data) &&
        resource.data.siteId is string &&
        resource.data.siteId.size() > 0 &&
        request.resource.data.siteId == resource.data.siteId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /sites/{siteId} {
      allow get, list: if true;
      allow create: if isSiteDocument(request.resource.data) &&
        request.resource.data.deletedAt == null;
      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow get, list: if true;
      allow create: if isPostDocument(request.resource.data) &&
        request.resource.data.deletedAt == null;
      allow update: if isPostDocument(request.resource.data) &&
        resource.data.siteId is string &&
        resource.data.siteId.size() > 0 &&
        request.resource.data.siteId == resource.data.siteId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
